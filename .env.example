# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# Hybrid GitHub RAG Backend Configuration
RAG_BACKEND_URL=https://hybrid-github-rag-backend.onrender.com

# Product Installer Download
PRODUCT_DOWNLOAD_URL=https://qrxjyvezlotjwggtgoqe.supabase.co/storage/v1/object/public/assets/PrivCloud_Setup.exe

# CORS Allowed Origins (comma-separated, no wildcards — wildcards are handled by allow_origin_regex)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5001,http://127.0.0.1:5001

# Email Dispatch (Resend API — optional, enables OTP email delivery)
RESEND_API_KEY=your_resend_api_key_here

# AI Chatbot LLM Keys (optional — for hybrid RAG chatbot)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat
FALLBACK_CASCADE_ORDER=local,groq,openrouter

# Remote License Server URL (optional)
LICENSE_SERVER_URL=https://owncloudx.onrender.com
