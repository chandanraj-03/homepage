{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/auth_page/auth.html" },
    { "source": "/register", "destination": "/auth_page/auth.html" },
    { "source": "/auth", "destination": "/auth_page/auth.html" },
    { "source": "/product", "destination": "/product_page/product.html" },
    { "source": "/purchase", "destination": "/purchase_page/purchase.html" },
    { "source": "/checkout", "destination": "/purchase_page/purchase.html" },
    { "source": "/demo", "destination": "/demo_page/demo.html" },
    { "source": "/about", "destination": "/demo_page/demo.html" },
    { "source": "/feedback", "destination": "/feedback_page/feedback.html" },
    { "source": "/support", "destination": "/support_page/customer_support.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
